# =============================================
#   FourPark API — Variables de entorno
# =============================================

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fourpark
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_SSL=false

# JWT
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga_y_aleatoria
JWT_EXPIRES_IN=24h

# Nodemailer (usa una App Password de Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
EMAIL_FROM="FourPark <tu_correo@gmail.com>"

# Frontend (para CORS y links en emails)
FRONTEND_URL=http://localhost:4200
